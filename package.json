{
  "name": "raildrop",
  "version": "0.2.0",
  "description": "Type-safe uploads and public delivery for Railway Buckets and Railway CDN",
  "license": "MIT",
  "author": "akpor-kofi (https://github.com/akpor-kofi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akpor-kofi/raildrop.git"
  },
  "homepage": "https://github.com/akpor-kofi/raildrop#readme",
  "bugs": "https://github.com/akpor-kofi/raildrop/issues",
  "keywords": [
    "s3",
    "file-upload",
    "uploads",
    "presigned-urls",
    "multipart-upload",
    "resumable",
    "react",
    "react-native",
    "expo",
    "hono",
    "railway",
    "cdn",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "raildrop": "./bin/raildrop.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./expo": {
      "types": "./dist/expo/index.d.ts",
      "import": "./dist/expo/index.js",
      "require": "./dist/expo/index.cjs"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "import": "./dist/hono/index.js",
      "require": "./dist/hono/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src test",
    "prepack": "pnpm build",
    "test": "tsx --test test/**/*.test.ts",
    "test:bundle": "pnpm build && node ./scripts/check-client-bundle.mjs",
    "test:package": "pnpm build && node ./scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@noble/hashes": "^2.2.0"
  },
  "peerDependencies": {
    "hono": ">=4.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.35.0",
    "@types/node": "*",
    "@types/react": "^19.2.0",
    "eslint": "^9.35.0",
    "hono": "^4.7.12",
    "react": "19.2.0",
    "tsup": "^8.5.0",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.6.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
